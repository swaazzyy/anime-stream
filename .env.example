# ========================================================
# Configuración de VPN para GoAnime + Gluetun
# ========================================================

# 0. Clave de la API de control de Gluetun (obligatoria desde Gluetun v3.39.1)
# Genera una aleatoria, por ejemplo: openssl rand -hex 24
GLUETUN_API_KEY=

# 1. Proveedor de VPN
# Opciones soportadas: mullvad, protonvpn, nordvpn, surfshark, pia, windscribe, cyberghost, custom, etc.
VPN_SERVICE_PROVIDER=mullvad

# 2. Tipo de Protocolo (wireguard o openvpn)
VPN_TYPE=wireguard

# 3. Credenciales según tu proveedor:

# --- Opción A: Mullvad WireGuard ---
# WIREGUARD_PRIVATE_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx=
# WIREGUARD_ADDRESSES=10.64.0.1/32
# SERVER_COUNTRIES=Switzerland

# --- Opción B: ProtonVPN OpenVPN ---
# OPENVPN_USER=tu_usuario_openvpn_proton
# OPENVPN_PASSWORD=tu_password_openvpn_proton
# SERVER_COUNTRIES=Netherlands

# --- Opción C: NordVPN OpenVPN ---
# OPENVPN_USER=tu_usuario_servicio_nordvpn
# OPENVPN_PASSWORD=tu_password_servicio_nordvpn
# SERVER_COUNTRIES=Spain

# --- Opción D: Surfshark WireGuard ---
# WIREGUARD_PRIVATE_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx=
# WIREGUARD_ADDRESSES=10.14.0.2/16
# SERVER_COUNTRIES=France
